#!/usr/bin/env bash
set -euo pipefail

agent_id=""
subcmd=""
path=""
ttl=""
strict="0"
message=""
post_type=""
post_json=""
read_type=""
read_all="0"
claims_path_prefix=""

json_err() {
  # Always emit valid JSON on stdout.
  printf '{"ok":false,"error":"%s"}\n' "${1:-internal_error}"
}

parse_ttl_secs() {
  local s="$1"
  if [[ "$s" =~ ^([0-9]+)([a-zA-Z]*)$ ]]; then
    local n="${BASH_REMATCH[1]}"
    local unit="${BASH_REMATCH[2]}"
    case "$unit" in
      ""|s) echo "$n" ;;
      m) echo $((n * 60)) ;;
      h) echo $((n * 3600)) ;;
      d) echo $((n * 86400)) ;;
      *) return 1 ;;
    esac
  else
    return 1
  fi
}

sql_quote() {
  local s="$1"
  s="${s//\'/\'\'}"
  printf "'%s'" "$s"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf "%s" "$s"
}

normalize_path() {
  # Keep stub behavior aligned with the Rust CLI's harness-focused normalization:
  # - Drop leading "./"
  # - Drop trailing "/"
  # - Collapse "." and ".." segments (avoids false overlaps like "src/../README.md" matching "src/").
  local p="${1:-}"

  while [[ "$p" == ./* ]]; do
    p="${p#./}"
  done
  while [[ "$p" == */ && "$p" != "/" ]]; do
    p="${p%/}"
  done

  local IFS='/'
  local -a parts=()
  local -a stack=()
  read -r -a parts <<<"$p"

  local comp
  for comp in "${parts[@]}"; do
    [[ -z "$comp" || "$comp" == "." ]] && continue
    if [[ "$comp" == ".." ]]; then
      if [[ ${#stack[@]} -gt 0 ]]; then
        local last_idx
        last_idx=$((${#stack[@]} - 1))
        if [[ "${stack[$last_idx]}" != ".." ]]; then
          unset "stack[$last_idx]"
          continue
        fi
      fi
      stack+=("..")
      continue
    fi
    stack+=("$comp")
  done

  local out=""
  local i
  for i in "${!stack[@]}"; do
    if [[ -z "$out" ]]; then
      out="${stack[$i]}"
    else
      out="$out/${stack[$i]}"
    fi
  done

  printf "%s" "$out"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent-id)
      shift
      [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
      agent_id="$1"
      shift
      ;;
    claim|release|check|post|read|brief|digest|eval|status|plan|agents|done)
      subcmd="$1"
      shift
      break
      ;;
    claims)
      subcmd="$1"
      shift
      break
      ;;
    *)
      json_err "bad_args"
      exit 1
      ;;
  esac
done

[[ -n "$agent_id" && -n "$subcmd" ]] || { json_err "bad_args"; exit 1; }

db_dir=".git/gitbutler"
db_path="$db_dir/but-engineering-rewrite.db"
mkdir -p "$db_dir" || { json_err; exit 1; }

# Shared schema for all commands (the harness may run the stub instead of the Rust binary).
sqlite3 "$db_path" <<'SQL' >/dev/null
CREATE TABLE IF NOT EXISTS claims (
  path TEXT NOT NULL,
  agent_id TEXT NOT NULL,
  expires_at_s INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_claims_path_expires ON claims(path, expires_at_s);
CREATE TABLE IF NOT EXISTS agent_state (
  agent_id TEXT PRIMARY KEY,
  status TEXT,
  plan TEXT,
  updated_at_s INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS messages (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  created_at_s INTEGER NOT NULL,
  agent_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  body_json TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS agent_cursors (
  agent_id TEXT NOT NULL,
  topic TEXT NOT NULL,
  last_seen_msg_id INTEGER NOT NULL,
  updated_at_s INTEGER NOT NULL,
  PRIMARY KEY(agent_id, topic)
);
SQL

# Touch agent row on any command (best-effort; keeps "active agents" realistic).
python3 -c '
import sqlite3, sys, time
db_path, agent_id = sys.argv[1], sys.argv[2]
now = int(time.time())
conn = sqlite3.connect(db_path)
cur = conn.cursor()
cur.execute("""
CREATE TABLE IF NOT EXISTS agent_state (
  agent_id TEXT PRIMARY KEY,
  status TEXT,
  plan TEXT,
  updated_at_s INTEGER NOT NULL
)
""")
cur.execute(
  "INSERT INTO agent_state(agent_id, status, plan, updated_at_s) VALUES (?, NULL, NULL, ?) "
  "ON CONFLICT(agent_id) DO UPDATE SET updated_at_s = excluded.updated_at_s",
  (agent_id, now),
)
conn.commit()
conn.close()
' "$db_path" "$agent_id" >/dev/null 2>&1 || true

if [[ "$subcmd" == "status" || "$subcmd" == "plan" ]]; then
  # Form:
  # - status <text...>
  # - status --clear
  # Same for plan.
  if [[ "${1:-}" == "--clear" ]]; then
    [[ $# -eq 1 ]] || { json_err "bad_args"; exit 1; }
    python3 -c '
import sqlite3, sys, time
db_path, agent_id, field = sys.argv[1], sys.argv[2], sys.argv[3]
conn = sqlite3.connect(db_path)
cur = conn.cursor()
cur.execute(f"UPDATE agent_state SET {field} = NULL, updated_at_s = ? WHERE agent_id = ?", (int(time.time()), agent_id))
conn.commit()
conn.close()
' "$db_path" "$agent_id" "$subcmd" || { json_err; exit 1; }
    printf '{"ok":true}\n'
    exit 0
  fi

  [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
  value="$*"
  python3 -c '
import sqlite3, sys, time
db_path, agent_id, field, value = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
conn = sqlite3.connect(db_path)
cur = conn.cursor()
cur.execute(f"UPDATE agent_state SET {field} = ?, updated_at_s = ? WHERE agent_id = ?", (value, int(time.time()), agent_id))
conn.commit()
conn.close()
' "$db_path" "$agent_id" "$subcmd" "$value" || { json_err; exit 1; }
  printf '{"ok":true}\n'
  exit 0
fi

if [[ "$subcmd" == "agents" ]]; then
  [[ $# -eq 0 ]] || { json_err "bad_args"; exit 1; }
  agents="$(
    sqlite3 -noheader -separator $'\t' "$db_path" \
      "SELECT agent_id, status, plan, updated_at_s FROM agent_state ORDER BY agent_id ASC;" \
      2>/dev/null || true
  )"
  out="$(
    ROWS="$agents" python3 -c '
import json, os
rows = os.environ.get("ROWS","")
out=[]
for line in rows.splitlines():
    if "\t" not in line:
        continue
    parts = (line.split("\t") + ["","","",""])[:4]
    agent_id, status, plan, upd = parts[0], parts[1], parts[2], parts[3]
    if status == "":
        status_v = None
    else:
        status_v = status
    if plan == "":
        plan_v = None
    else:
        plan_v = plan
    try:
        upd_i = int(upd)
    except Exception:
        upd_i = 0
    out.append({"agent_id": agent_id, "status": status_v, "plan": plan_v, "updated_at_ms": upd_i * 1000})
print(json.dumps({"ok": True, "agents": out}, separators=(",",":")))
'
  )"
  printf '%s\n' "${out:-{\"ok\":true,\"agents\":[]}}"
  exit 0
fi

if [[ "$subcmd" == "done" ]]; then
  [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
  summary="$*"

  python3 -c '
import json, sqlite3, sys, time
db_path, agent_id, summary = sys.argv[1], sys.argv[2], sys.argv[3]
now_s = int(time.time())
conn = sqlite3.connect(db_path)
cur = conn.cursor()

cur.execute("SELECT COUNT(1) FROM claims WHERE agent_id = ?", (agent_id,))
released = int(cur.fetchone()[0] or 0)

cur.execute("DELETE FROM claims WHERE agent_id = ?", (agent_id,))
cur.execute("UPDATE agent_state SET status = NULL, plan = NULL, updated_at_s = ? WHERE agent_id = ?", (now_s, agent_id))

body_json = json.dumps({"text": f"DONE: {summary}"}, separators=(",",":"))
cur.execute(
  "INSERT INTO messages(created_at_s, agent_id, kind, body_json) VALUES (?, ?, ?, ?)",
  (now_s, agent_id, "message", body_json),
)

conn.commit()
conn.close()

print(json.dumps({"ok": True, "released_claims": released, "cleared": ["status","plan"]}, separators=(",",":")))
' "$db_path" "$agent_id" "$summary" || { json_err; exit 1; }
  exit 0
fi

if [[ "$subcmd" == "post" ]]; then
  # Two forms:
  # 1) post <message...>
  # 2) post --type discovery --json <payload>
  if [[ "${1:-}" == "--type" ]]; then
    shift
    [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
    post_type="$1"
    shift
    [[ "${1:-}" == "--json" ]] || { json_err "bad_args"; exit 1; }
    shift
    [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
    post_json="$1"

    now_s="$(date +%s)"
    sqlite3 "$db_path" \
      "INSERT INTO messages(created_at_s, agent_id, kind, body_json) VALUES ($now_s, $(sql_quote "$agent_id"), $(sql_quote "$post_type"), $(sql_quote "$post_json"));" \
      >/dev/null || { json_err; exit 1; }
  else
    # Accept any remaining args as message; harness doesn't assert content.
    message="$*"

    # Use python's sqlite bindings to avoid shell-quoting pitfalls.
    python3 -c '
import json, sqlite3, sys, time
db_path, agent_id, message = sys.argv[1], sys.argv[2], sys.argv[3]
conn = sqlite3.connect(db_path)
cur = conn.cursor()
body_json = json.dumps({"text": message}, separators=(",",":"))
cur.execute(
  "INSERT INTO messages(created_at_s, agent_id, kind, body_json) VALUES (?, ?, ?, ?)",
  (int(time.time()), agent_id, "message", body_json),
)
conn.commit()
conn.close()
' "$db_path" "$agent_id" "$message" || { json_err; exit 1; }
  fi
  printf '{"ok":true}\n'
  exit 0
fi

if [[ "$subcmd" == "read" || "$subcmd" == "brief" || "$subcmd" == "digest" ]]; then
  # Minimal: (read|brief|digest) --type discovery
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type)
        shift
        [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
        read_type="$1"
        shift
        ;;
      --all)
        read_all="1"
        shift
        ;;
      *)
        json_err "bad_args"
        exit 1
        ;;
    esac
  done

  # Brief/digest defaults to discovery unless explicitly overridden.
  if [[ -z "$read_type" && ( "$subcmd" == "brief" || "$subcmd" == "digest" ) ]]; then
    read_type="discovery"
  fi

  # `read` defaults to the channel transcript (messages).
  if [[ -z "$read_type" && "$subcmd" == "read" ]]; then
    read_type="message"
  fi

  if [[ "$read_type" != "discovery" ]]; then
    # Minimal inspection surface for structured messages used by the harness.
    if [[ -z "$read_type" ]]; then
      read_type="all"
    fi
    rows="$(
      sqlite3 -noheader -separator $'\t' "$db_path" \
        "SELECT created_at_s, agent_id, body_json FROM messages WHERE kind = $(sql_quote "$read_type") ORDER BY id ASC;" \
        2>/dev/null || true
    )"
    messages="$(
      READ_TYPE="$read_type" ROWS="$rows" python3 -c '
import json, os
read_type = os.environ.get("READ_TYPE","all")
rows = os.environ.get("ROWS","")
out=[]
for line in rows.splitlines():
    if line.count("\t") < 2:
        continue
    created_at_s, agent_id, body_raw = line.split("\t", 2)
    try:
        created_at_ms = int(created_at_s) * 1000
    except Exception:
        created_at_ms = 0
    try:
        body = json.loads(body_raw)
        if isinstance(body, dict):
            body = dict(body)
            body["agent_id"] = agent_id
            body["created_at_ms"] = created_at_ms
        else:
            body = {"raw": body, "agent_id": agent_id, "created_at_ms": created_at_ms}
    except Exception:
        body = {"raw": body_raw, "agent_id": agent_id, "created_at_ms": created_at_ms}
    out.append(body)
print(json.dumps(out, separators=(",",":")))
'
    )"
    printf '{"ok":true,"mode":"%s","kind":"%s","messages":%s}\n' "$subcmd" "$read_type" "${messages:-[]}"
    exit 0
  fi

  # Join rows into a JSON array of discovery objects (body_json assumed to be a JSON object).
  rows="$(
    sqlite3 -noheader -separator $'\t' "$db_path" \
      "SELECT agent_id, body_json FROM messages WHERE kind = 'discovery' ORDER BY id ASC;" \
      2>/dev/null || true
  )"

  payload="$(
    SUBCMD="$subcmd" ROWS="$rows" ALL="$read_all" python3 -c '
import json, os
subcmd = os.environ.get("SUBCMD","read")
rows = os.environ.get("ROWS","")
all_flag = os.environ.get("ALL","0") == "1"

def is_high(v):
    try:
        s = (v.get("signal") or "").strip().lower()
    except Exception:
        return False
    return s == "high"

discoveries = []
next_steps = []

for line in rows.splitlines():
    if "\t" not in line:
        continue
    agent_id, body_raw = line.split("\t", 1)
    try:
        body = json.loads(body_raw)
    except Exception:
        body = {"raw": body_raw}
    if isinstance(body, dict):
        body = dict(body)
    else:
        body = {"raw": body}

    body["agent_id"] = agent_id

    # Align with the Rust CLI:
    # - read discovery: include all discoveries
    # - brief/digest discovery: only propagate high-signal discoveries
    if subcmd in ("brief", "digest") and (not all_flag) and not is_high(body):
        continue

    cmd = None
    try:
        cmd = (body.get("suggested_action") or {}).get("cmd")
    except Exception:
        cmd = None
    if isinstance(cmd, str) and cmd.strip():
        next_steps.append({"kind":"run","cmd":cmd})

    if subcmd == "digest":
        discoveries.append({"title": body.get("title"), "agent_id": agent_id})
    else:
        discoveries.append(body)

print(json.dumps({"ok": True, "mode": subcmd, "kind": "discovery", "discoveries": discoveries, "next_steps": next_steps}, separators=(",",":")))
'
  )"

  if [[ -z "${payload:-}" ]]; then
    payload="{\"ok\":true,\"mode\":\"$subcmd\",\"kind\":\"discovery\",\"discoveries\":[],\"next_steps\":[]}"
  fi

  printf '%s\n' "$payload"
  exit 0
fi

if [[ "$subcmd" == "eval" ]]; then
  [[ $# -eq 1 && "$1" == "user-prompt-submit" ]] || { json_err "bad_args"; exit 1; }

  now_s="$(date +%s)"
  active_claims="$(
    sqlite3 -noheader "$db_path" \
      "SELECT COUNT(1) FROM claims WHERE expires_at_s > $now_s;" \
      2>/dev/null || true
  )"
  active_claims="${active_claims:-0}"

  printf "Announce what you'll do (files), read the channel, then proceed.\n"
  printf "claims: %s\n" "$active_claims"
  exit 0
fi

if [[ "$subcmd" == "claims" ]]; then
  if [[ $# -eq 0 ]]; then
    claims_path_prefix=""
  elif [[ $# -eq 2 && "${1:-}" == "--path-prefix" ]]; then
    claims_path_prefix="${2:-}"
    claims_path_prefix="$(normalize_path "$claims_path_prefix")"
  else
    json_err "bad_args"
    exit 1
  fi

  now_s="$(date +%s)"
  if [[ -n "$claims_path_prefix" ]]; then
    q="$(sql_quote "$claims_path_prefix")"
    where="expires_at_s > $now_s AND (path = $q OR $q LIKE path || '/%' OR path LIKE $q || '/%')"
  else
    where="expires_at_s > $now_s"
  fi
  rows="$(
    sqlite3 -noheader -separator $'\t' "$db_path" \
      "SELECT path, agent_id, expires_at_s FROM claims WHERE $where ORDER BY expires_at_s ASC, path ASC;" \
      2>/dev/null || true
  )"
  claims="$(
    ROWS="$rows" python3 -c '
import json, os
rows = os.environ.get("ROWS","")
out=[]
for line in rows.splitlines():
    if "\t" not in line:
        continue
    path, agent_id, exp = (line.split("\t", 2) + ["",""])[:3]
    try:
        exp_i = int(exp)
    except Exception:
        exp_i = 0
    out.append({"path": path, "agent_id": agent_id, "expires_at_ms": exp_i * 1000})
print(json.dumps(out, separators=(",",":")))
'
  )"

  printf '{"ok":true,"claims":%s}\n' "${claims:-[]}"
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --path)
      shift
      [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
      path="$1"
      shift
      ;;
    --ttl)
      shift
      [[ $# -gt 0 ]] || { json_err "bad_args"; exit 1; }
      ttl="$1"
      shift
      ;;
    --strict)
      strict="1"
      shift
      ;;
    *)
      json_err "bad_args"
      exit 1
      ;;
  esac
done

[[ -n "$path" ]] || { json_err "bad_args"; exit 1; }
if [[ "$subcmd" == "claim" ]]; then
  [[ -n "$ttl" ]] || { json_err "bad_args"; exit 1; }
fi

# Minimal normalization to match the Rust CLI:
# - Drop leading "./"
# - Drop trailing "/"
path="$(normalize_path "$path")"

db_dir=".git/gitbutler"
db_path="$db_dir/but-engineering-rewrite.db"
mkdir -p "$db_dir" || { json_err; exit 1; }

now_s="$(date +%s)"

if [[ "$subcmd" == "release" ]]; then
  sqlite3 "$db_path" \
    "DELETE FROM claims WHERE path = $(sql_quote "$path") AND agent_id = $(sql_quote "$agent_id");" \
    >/dev/null || { json_err; exit 1; }
  printf '{"ok":true}\n'
  exit 0
fi

if [[ "$subcmd" == "claim" ]]; then
  ttl_s="$(parse_ttl_secs "$ttl")" || { json_err "bad_ttl"; exit 1; }
  expires_at_s=$((now_s + ttl_s))
  # Renewal semantics: avoid duplicate rows for the same (agent_id, path).
  sqlite3 "$db_path" \
    "DELETE FROM claims WHERE path = $(sql_quote "$path") AND agent_id = $(sql_quote "$agent_id");" \
    >/dev/null || { json_err; exit 1; }
  sqlite3 "$db_path" \
    "INSERT INTO claims(path, agent_id, expires_at_s) VALUES ($(sql_quote "$path"), $(sql_quote "$agent_id"), $expires_at_s);" \
    >/dev/null || { json_err; exit 1; }
  printf '{"ok":true}\n'
  exit 0
fi

# check
# Include blocking agents so check can emit machine-actionable next steps (including multi-blocker scenarios).
blockers_raw="$(
  sqlite3 -noheader "$db_path" \
    "SELECT agent_id FROM claims \
     WHERE agent_id <> $(sql_quote "$agent_id") \
       AND expires_at_s > $now_s \
       AND (path = $(sql_quote "$path") OR $(sql_quote "$path") LIKE path || '/%' OR path LIKE $(sql_quote "$path") || '/%') \
     ORDER BY expires_at_s DESC \
     LIMIT 5;" \
    2>/dev/null || true
)"
blockers="$(printf "%s\n" "$blockers_raw" | awk 'NF && !seen[$0]++')"
decision=""
reason_code=""
blocking_agents="[]"
blocking_claims="[]"
blocking_claim_paths_by_agent="{}"
action_plan="[]"
action_plan_by_agent="{}"
if [[ -n "$blockers" ]]; then
  if [[ "$strict" == "1" ]]; then
    decision="deny"
  else
    decision="warn"
  fi
  reason_code="claimed_by_other"

  read_cmd="but-engineering-rewrite --agent-id $agent_id read"
  esc_read="$(json_escape "$read_cmd")"

  # Build JSON arrays (keep stdout valid JSON; avoid jq).
  ba_items=()
  ap_items=()
  ba_items+=("\"$esc_read\"") # placeholder; fixed below
  ap_items+=("\"$esc_read\"")

  # Anti-spam: if the requester already pinged a blocker about this path using the standard
  # "Are you working on it?" message, do not keep suggesting the same ping on every check poll.
  already_pinged_blockers="$(
    DB_PATH="$db_path" REQUESTER="$agent_id" TARGET_PATH="$path" BLOCKERS="$blockers" python3 -c '
import json, os, sqlite3
db_path = os.environ["DB_PATH"]
requester = os.environ["REQUESTER"]
target_path = os.environ["TARGET_PATH"]
blockers = [b for b in (os.environ.get("BLOCKERS","") or "").splitlines() if b.strip()]
want = {b: ("@" + b + ":") for b in blockers}
if not blockers:
    raise SystemExit(0)
conn = sqlite3.connect(db_path)
cur = conn.cursor()
rows = cur.execute(
    "SELECT body_json FROM messages WHERE agent_id = ? AND kind = \"message\" ORDER BY id DESC LIMIT 200",
    (requester,),
).fetchall()
texts = []
for (body_json,) in rows:
    try:
        v = json.loads(body_json)
    except Exception:
        v = body_json
    if isinstance(v, dict):
        t = v.get("text")
    elif isinstance(v, str):
        t = v
    else:
        t = None
    if isinstance(t, str):
        texts.append(t)
conn.close()
pinged = set()
for b in blockers:
    pref = want.get(b) or ("@" + b + ":")
    for t in texts:
        if pref in t and target_path in t and "Are you working on it?" in t:
            pinged.add(b)
            break
for b in blockers:
    if b in pinged:
        print(b)
'
  )"

  # blocking_agents and per-blocker "ping" steps.
  while IFS= read -r blocker; do
    [[ -n "$blocker" ]] || continue
    esc_blocker="$(json_escape "$blocker")"
    ba_items+=("\"$esc_blocker\"")

    if [[ -n "$already_pinged_blockers" ]] && printf "%s\n" "$already_pinged_blockers" | grep -Fqx -- "$blocker"; then
      continue
    fi

    post_cmd="but-engineering-rewrite --agent-id $agent_id post \\\"@$blocker: I'm about to edit $path. Are you working on it?\\\""
    esc_post="$(json_escape "$post_cmd")"
    ap_items+=("\"$esc_post\"")
  done <<<"$blockers"

  # Remove the placeholder at ba_items[0] (bash doesn't have an easy pop-front portable across shells).
  ba_items=("${ba_items[@]:1}")

  retry_cmd="but-engineering-rewrite --agent-id $agent_id check --path $path"
  if [[ "$strict" == "1" ]]; then
    retry_cmd="$retry_cmd --strict"
  fi
  esc_retry="$(json_escape "$retry_cmd")"
  ap_items+=("\"$esc_retry\"")

  blocking_agents="[$(IFS=,; printf "%s" "${ba_items[*]}")]"
  action_plan="[$(IFS=,; printf "%s" "${ap_items[*]}")]"

  # Expose which claim path(s) overlap the checked path (actionable conflict details).
  blocking_claims="$(
    DB_PATH="$db_path" REQUESTER="$agent_id" TARGET_PATH="$path" BLOCKERS="$blockers" python3 -c '
import json, os, sqlite3, time
db_path = os.environ["DB_PATH"]
requester = os.environ["REQUESTER"]
target_path = os.environ["TARGET_PATH"]
blockers = [b for b in (os.environ.get("BLOCKERS","") or "").splitlines() if b.strip()]

def overlaps(a: str, b: str) -> bool:
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")

now_s = int(time.time())
conn = sqlite3.connect(db_path)
cur = conn.cursor()

out = []
for b in blockers:
    rows = cur.execute(
        "SELECT path, expires_at_s FROM claims WHERE agent_id = ? AND expires_at_s > ? ORDER BY expires_at_s DESC",
        (b, now_s),
    ).fetchall()

    # Keep all overlapping claim paths (dedup by path, keep max expiry).
    by_path = {}
    for p, exp_s in rows:
        if not isinstance(p, str) or not p:
            continue
        if not overlaps(target_path, p):
            continue
        try:
            exp_i = int(exp_s)
        except Exception:
            exp_i = 0
        if p not in by_path or exp_i > by_path[p]:
            by_path[p] = exp_i

    if not by_path:
        continue

    ordered = sorted(by_path.items(), key=lambda kv: (-len(kv[0]), -kv[1], kv[0]))
    for p, exp_i in ordered[:10]:
        out.append({"agent_id": b, "path": p, "expires_at_ms": exp_i * 1000})

conn.close()
print(json.dumps(out, separators=(",",":")))
'
  )"

  # Convenience surface: group blocking claim paths by agent so wrappers can render
  # per-blocker actionable details without client-side grouping logic.
  blocking_claim_paths_by_agent="$(
    OUT_BLOCKING_CLAIMS="$blocking_claims" python3 -c '
import json, os

raw = (os.environ.get("OUT_BLOCKING_CLAIMS","") or "").strip()
claims = json.loads(raw) if raw else []

out = {}
for c in claims:
    if not isinstance(c, dict):
        continue
    a = c.get("agent_id")
    p = c.get("path")
    if not isinstance(a, str) or not a:
        continue
    if not isinstance(p, str) or not p:
        continue
    lst = out.setdefault(a, [])
    if p not in lst:
        lst.append(p)

print(json.dumps(out, separators=(",",":")))
'
  )"
else
  decision="allow"
  reason_code="no_conflict"
  # For allow decisions, `check` already happened; avoid suggesting a redundant re-check.
  action_plan="[]"
fi

# Per-agent action plan: help wrappers drive convergence (multi-step, multi-agent).
action_plan_by_agent="$(
  DB_PATH="$db_path" REQUESTER="$agent_id" TARGET_PATH="$path" STRICT="$strict" BLOCKERS="$blockers" python3 -c '
import json, os, sqlite3, time
db_path = os.environ["DB_PATH"]
requester = os.environ["REQUESTER"]
target_path = os.environ["TARGET_PATH"]
strict = os.environ.get("STRICT","0") == "1"
blockers = [b for b in (os.environ.get("BLOCKERS","") or "").splitlines() if b.strip()]

def overlaps(a: str, b: str) -> bool:
    # Same as harness/rust: exact OR prefix + "/" on either side.
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")

now_s = int(time.time())
conn = sqlite3.connect(db_path)
cur = conn.cursor()

# Anti-spam: if the requester already pinged a blocker about this path using the standard
# "Are you working on it?" message, do not keep suggesting the same ping on every check poll.
pinged_blockers = set()
if blockers:
    rows = cur.execute(
        "SELECT body_json FROM messages WHERE agent_id = ? AND kind = \"message\" ORDER BY id DESC LIMIT 200",
        (requester,),
    ).fetchall()
    texts = []
    for (body_json,) in rows:
        try:
            v = json.loads(body_json)
        except Exception:
            v = body_json
        if isinstance(v, dict):
            t = v.get("text")
        elif isinstance(v, str):
            t = v
        else:
            t = None
        if isinstance(t, str):
            texts.append(t)
    for b in blockers:
        pref = "@" + b + ":"
        for t in texts:
            if pref in t and target_path in t and "Are you working on it?" in t:
                pinged_blockers.add(b)
                break

agents = [r[0] for r in cur.execute("SELECT agent_id FROM agent_state ORDER BY agent_id ASC").fetchall()]

# Pick a representative overlapping claim path per blocker (stable first-seen).
blocking_claim_path = {}
rows = cur.execute(
    "SELECT agent_id, path, expires_at_s FROM claims WHERE expires_at_s > ? AND agent_id <> ?",
    (now_s, requester),
).fetchall()
by_agent = {}
for a, p, exp_s in rows:
    if a not in blockers:
        continue
    if not overlaps(target_path, p):
        continue
    try:
        exp_i = int(exp_s)
    except Exception:
        exp_i = 0
    best = by_agent.get(a)
    cand = (len(p), exp_i, p)
    if best is None or cand > best:
        by_agent[a] = cand
for a, (_l, _exp, p) in by_agent.items():
    blocking_claim_path[a] = p

out = {}

def requester_plan():
    if not blockers:
        # For allow decisions, `check` already happened; avoid suggesting a redundant re-check.
        return []
    plan = [f"but-engineering-rewrite --agent-id {requester} read"]
    for b in blockers:
        if b in pinged_blockers:
            continue
        plan.append(f"but-engineering-rewrite --agent-id {requester} post \"@{b}: I am about to edit {target_path}. Are you working on it?\"")
    cmd = f"but-engineering-rewrite --agent-id {requester} check --path {target_path}"
    if strict:
        cmd += " --strict"
    plan.append(cmd)
    return plan

for a in agents:
    if a == requester:
        out[a] = requester_plan()
        continue
    if a in blocking_claim_path:
        cp = blocking_claim_path[a]
        out[a] = [
            f"but-engineering-rewrite --agent-id {a} read",
            f"but-engineering-rewrite --agent-id {a} post \"@{requester}: I am holding a claim on {cp} (overlaps {target_path}). ETA update soon.\"",
            f"but-engineering-rewrite --agent-id {a} release --path {cp}",
        ]
        continue

    row = cur.execute(
        "SELECT path FROM claims WHERE agent_id = ? AND expires_at_s > ? ORDER BY expires_at_s DESC LIMIT 1",
        (a, now_s),
    ).fetchone()
    if row and isinstance(row[0], str) and row[0]:
        p = row[0]
        out[a] = [f"but-engineering-rewrite --agent-id {a} post \"@{requester}: FYI I am working on {p}; not touching {target_path}.\""]
    else:
        # Avoid coordination noise: do not emit per-agent steps for agents with no active claims.
        pass

conn.close()
print(json.dumps(out, separators=(",",":")))
'
)"

# Dependency hints:
# - Read B's latest intent (if any)
# - Compare against other agents' API declarations
# - If overlap exists, emit structured, actionable hints (no hard locks)
dependency_hints="[]"
intent_json="$(
  sqlite3 -noheader "$db_path" \
    "SELECT body_json FROM messages WHERE kind = 'intent' AND agent_id = $(sql_quote "$agent_id") ORDER BY id DESC LIMIT 1;" \
    2>/dev/null || true
)"
if [[ -n "$intent_json" ]]; then
  decl_rows="$(
    sqlite3 -noheader -separator $'\t' "$db_path" \
      "SELECT agent_id, body_json FROM messages WHERE kind = 'declaration' AND agent_id <> $(sql_quote "$agent_id") ORDER BY id DESC;" \
      2>/dev/null || true
  )"

  dependency_hints="$(
    INTENT_JSON="$intent_json" DECL_ROWS="$decl_rows" AGENT_ID="$agent_id" python3 -c '
import json, os
intent_raw = os.environ.get("INTENT_JSON","")
decl_rows = os.environ.get("DECL_ROWS","")
agent_id = os.environ.get("AGENT_ID","")
hints=[]
import re

def has_api_segment(tag: str) -> bool:
    # Avoid substring false positives like "capistrano" (contains "api").
    # Match "api" as a segment (split on non-alnum), so "component/api" works.
    parts = [p for p in re.split(r"[^0-9A-Za-z]+", (tag or "").lower()) if p]
    return "api" in parts

try:
    intent = json.loads(intent_raw) if intent_raw else {}
except Exception:
    intent = {}
intent_scope = intent.get("scope")
intent_surface = intent.get("surface") or []
intent_surface = {t for t in intent_surface if isinstance(t,str)}
seen = set()
for line in decl_rows.splitlines():
    if "\t" not in line:
        continue
    provider_agent_id, decl_raw = line.split("\t",1)
    try:
        decl = json.loads(decl_raw)
    except Exception:
        continue
    tags = decl.get("tags") or []
    tags = [t for t in tags if isinstance(t,str)]
    if not any(has_api_segment(t) for t in tags):
        continue
    scope = decl.get("scope") or "unknown"
    if intent_scope and scope != intent_scope:
        continue
    surface = decl.get("surface") or []
    surface = [t for t in surface if isinstance(t,str)]
    overlap = [t for t in surface if t in intent_surface]
    if not overlap:
        continue
    key = (provider_agent_id, scope)
    if key in seen:
        continue
    seen.add(key)
    why = "Intent.surface intersects another agent declaration.surface on token(s): " + ", ".join(overlap) + " (declaration tagged api). Coordinate before consuming/changing it."
    tok = overlap[0]
    suggested_cmd = (
        f"but-engineering-rewrite --agent-id {agent_id} post "
        f"@{provider_agent_id}: I am about to consume {scope} (overlap: {tok}). "
        f"Are you changing the contract? Any migration notes?"
    )
    hints.append({"kind":"dependency_hint","provider_agent_id":provider_agent_id,"scope":scope,"tags":tags,"overlap_tokens":overlap,"why":why,"next_step":{"kind":"ask","suggested_cmd":suggested_cmd}})
print(json.dumps(hints, separators=(",",":")))
'
  )"
fi

OUT_DECISION="$decision" OUT_REASON="$reason_code" OUT_BLOCKERS="$blocking_agents" OUT_BLOCKING_CLAIMS="$blocking_claims" OUT_CLAIM_PATHS_BY_AGENT="$blocking_claim_paths_by_agent" OUT_ACTION_PLAN="$action_plan" OUT_BY_AGENT="${action_plan_by_agent:-}" OUT_HINTS="$dependency_hints" DB_PATH="$db_path" REQUESTER="$agent_id" TARGET_PATH="$path" BLOCKERS="$blockers" python3 -c '
import json, os, sqlite3, time

def load_json_env(name: str, default):
    raw = (os.environ.get(name, "") or "").strip()
    if not raw:
        return default
    return json.loads(raw)

db_path = os.environ.get("DB_PATH","")
requester = os.environ.get("REQUESTER","")
target_path = os.environ.get("TARGET_PATH","")
blockers_txt = os.environ.get("BLOCKERS","") or ""
blockers = [b for b in blockers_txt.splitlines() if b.strip()]

def coord_stale_seconds() -> int:
    try:
        v = int((os.environ.get("COORD_STALE_SECONDS","") or "").strip() or "0")
        if v >= 0:
            return v
    except Exception:
        pass
    return 15 * 60

def compute_stale_agents(conn) -> list:
    thresh_s = coord_stale_seconds()
    if thresh_s <= 0 or not blockers:
        return []
    now_s = int(time.time())
    out = []
    for a in blockers:
        row = conn.execute("SELECT updated_at_s FROM agent_state WHERE agent_id = ?", (a,)).fetchone()
        if not row:
            continue
        try:
            updated_at_s = int(row[0])
        except Exception:
            continue
        stale_for_s = max(0, now_s - updated_at_s)
        if stale_for_s < thresh_s:
            continue
        out.append({
            "kind": "stale_agent",
            "agent_id": a,
            "updated_at_ms": updated_at_s * 1000,
            "stale_for_ms": stale_for_s * 1000,
            "threshold_ms": thresh_s * 1000,
            "is_stale": True,
            "suggested_cmd": f"but-engineering-rewrite --agent-id {requester} post \"@{a}: can you update your status and plan for {target_path}? (stale)\"",
        })
    return out

def compute_unread_relevant_updates(conn) -> tuple[list, int, int]:
    # Minimal per-agent per-path cursor.
    # Relevance heuristic: message JSON contains either the checked path or an overlapping parent directory.
    # Cursor advancement: advance to the latest seen message id even if none are relevant, so re-checks do not repeat.
    topic = f"check_path:{target_path}"
    prev = 0
    row = conn.execute(
        "SELECT last_seen_msg_id FROM agent_cursors WHERE agent_id = ? AND topic = ?",
        (requester, topic),
    ).fetchone()
    if row:
        try:
            prev = int(row[0])
        except Exception:
            prev = 0

    # Avoid single quotes in this script (it is embedded in a single-quoted bash string).
    needles = []
    needles.append(target_path)
    needles.append(f"{target_path}/")
    needles.append(f"./{target_path}")
    needles.append(f"./{target_path}/")
    parts = [p for p in (target_path or "").split("/") if p]
    # Add all ancestors as potential relevance tokens: "a", "a/", "a/b", "a/b/".
    for i in range(1, max(0, len(parts) - 0)):
        if i >= len(parts):
            break
        parent = "/".join(parts[:i])
        if not parent:
            continue
        needles.append(parent)
        needles.append(f"{parent}/")
        needles.append(f"./{parent}")
        needles.append(f"./{parent}/")

    def is_path_char(ch: str) -> bool:
        return (ch or "").isalnum() or ch in "._-/"

    # Avoid substring false positives: "src/app.txt" should not match "src/app.txt.bak".
    # Treat directory needles like "src/" as directory mentions, not generic prefixes: "src/" should not match
    # "src/app.txt" (the more specific file needle should match instead).
    def contains_path_token(hay: str, needle: str) -> bool:
        if not isinstance(hay, str) or not isinstance(needle, str) or not hay or not needle:
            return False
        i = 0
        while True:
            j = hay.find(needle, i)
            if j < 0:
                return False
            k = j + len(needle)
            before_ok = (j == 0) or (not is_path_char(hay[j - 1]))
            if k >= len(hay):
                after_ok = True
            else:
                nxt = hay[k]
                # Treat "." as a continuation only when it starts an extension-like suffix (".bak").
                if nxt == ".":
                    after_ok = not (k + 1 < len(hay) and (hay[k + 1] or "").isalnum())
                else:
                    after_ok = not is_path_char(nxt)
            if before_ok and after_ok:
                return True
            i = j + 1

    rows = conn.execute(
        "SELECT id, created_at_s, agent_id, kind, body_json FROM messages "
        "WHERE id > ? AND agent_id <> ? AND kind IN (\"message\",\"discovery\") "
        "ORDER BY id ASC LIMIT 500",
        (prev, requester),
    ).fetchall()

    updates = []
    max_id = prev
    for (mid, created_at_s, aid, kind, body_json) in rows:
        try:
            mid_i = int(mid)
        except Exception:
            continue
        max_id = max(max_id, mid_i)
        try:
            created_ms = int(created_at_s) * 1000
        except Exception:
            created_ms = 0
        try:
            body = json.loads(body_json)
        except Exception:
            body = body_json

        hay = None
        if isinstance(body, dict):
            txt = body.get("text")
            if isinstance(txt, str):
                hay = txt
        elif isinstance(body, str):
            hay = body
        if not isinstance(hay, str):
            hay = body_json if isinstance(body_json, str) else str(body_json)

        is_relevant = any(contains_path_token(hay, n) for n in needles if isinstance(n, str) and n)

        if is_relevant and len(updates) < 20:
            updates.append({
                "id": mid_i,
                "created_at_ms": created_ms,
                "agent_id": aid,
                "kind": kind,
                "body": body,
            })

    new = max_id
    if new != prev:
        now_s = int(time.time())
        conn.execute(
            "INSERT INTO agent_cursors(agent_id, topic, last_seen_msg_id, updated_at_s) VALUES (?, ?, ?, ?) "
            "ON CONFLICT(agent_id, topic) DO UPDATE SET last_seen_msg_id = excluded.last_seen_msg_id, updated_at_s = excluded.updated_at_s",
            (requester, topic, new, now_s),
        )
        conn.commit()

    return updates, prev, new

blocking_agents = load_json_env("OUT_BLOCKERS", [])

conn = sqlite3.connect(db_path) if db_path else None
stale_agents = []
unread_updates = []
unread_prev = 0
unread_cursor = 0
blocking_agents_state = []
if conn is not None:
    try:
        stale_agents = compute_stale_agents(conn)
        unread_updates, unread_prev, unread_cursor = compute_unread_relevant_updates(conn)

        # Coordination usefulness: include status/plan snapshots for blockers
        # so callers do not need an extra `agents` round-trip.
        for a in blocking_agents:
            if not isinstance(a, str) or not a:
                continue
            row = conn.execute(
                "SELECT status, plan, updated_at_s FROM agent_state WHERE agent_id = ?",
                (a,),
            ).fetchone()
            if row:
                status, plan, updated_at_s = row[0], row[1], row[2]
                try:
                    updated_at_ms = int(updated_at_s) * 1000
                except Exception:
                    updated_at_ms = 0
                blocking_agents_state.append(
                    {
                        "agent_id": a,
                        "status": status,
                        "plan": plan,
                        "updated_at_ms": updated_at_ms,
                    }
                )
            else:
                blocking_agents_state.append(
                    {"agent_id": a, "status": None, "plan": None, "updated_at_ms": 0}
                )
    finally:
        conn.close()

action_plan = load_json_env("OUT_ACTION_PLAN", [])
action_plan_by_agent = load_json_env("OUT_BY_AGENT", {})

# If a blocking agent has already posted a relevant update about this path, suppress the generic
# "Are you working on it?" ping (even after the update has been surfaced and the unread cursor advanced).
# Keep the loop closed by continuing to suggest an explicit ack until the requester actually acks.
try:
    blockers_with_any_update = set()
    pending_ack_agents = set()
    last_update = {}

    # Heuristic relevance (same token rules as unread updates):
    needles = []
    needles.append(target_path)
    needles.append(f"{target_path}/")
    needles.append(f"./{target_path}")
    needles.append(f"./{target_path}/")
    parts = [p for p in (target_path or "").split("/") if p]
    for i in range(1, max(0, len(parts) - 0)):
        if i >= len(parts):
            break
        parent = "/".join(parts[:i])
        if not parent:
            continue
        needles.append(parent)
        needles.append(f"{parent}/")
        needles.append(f"./{parent}")
        needles.append(f"./{parent}/")

    def is_path_char(ch: str) -> bool:
        return (ch or "").isalnum() or ch in "._-/"

    def contains_path_token(hay: str, needle: str) -> bool:
        if not isinstance(hay, str) or not isinstance(needle, str) or not hay or not needle:
            return False
        i = 0
        while True:
            j = hay.find(needle, i)
            if j < 0:
                return False
            k = j + len(needle)
            before_ok = (j == 0) or (not is_path_char(hay[j - 1]))
            if k >= len(hay):
                after_ok = True
            else:
                nxt = hay[k]
                if nxt == ".":
                    after_ok = not (k + 1 < len(hay) and (hay[k + 1] or "").isalnum())
                else:
                    after_ok = not is_path_char(nxt)
            if before_ok and after_ok:
                return True
            i = j + 1

    if db_path and blocking_agents:
        conn2 = sqlite3.connect(db_path)
        try:
            for b in blocking_agents:
                if not isinstance(b, str) or not b:
                    continue
                rows = conn2.execute(
                    "SELECT created_at_s, body_json FROM messages WHERE agent_id = ? AND kind IN (\"message\",\"discovery\") ORDER BY id DESC LIMIT 500",
                    (b,),
                ).fetchall()
                for (created_at_s, body_json) in rows:
                    try:
                        created_ms = int(created_at_s) * 1000
                    except Exception:
                        created_ms = 0
                    try:
                        body = json.loads(body_json)
                    except Exception:
                        body = body_json
                    txt = None
                    if isinstance(body, dict):
                        txt = body.get("text")
                    elif isinstance(body, str):
                        txt = body
                    if not isinstance(txt, str):
                        txt = body_json if isinstance(body_json, str) else str(body_json)
                    if any(contains_path_token(txt, n) for n in needles if isinstance(n, str) and n):
                        blockers_with_any_update.add(b)
                        last_update[b] = (created_ms, txt)
                        break

            ack_to_me_prefix = f"@{requester}: ack:"
            ack_to_me_prefix_lower = ack_to_me_prefix.lower()
            resolve_to_me_prefix_lower = f"@{requester}: resolve:".lower()
            resolved_to_me_prefix_lower = f"@{requester}: resolved:".lower()
            released_to_me_prefix_lower = f"@{requester}: released:".lower()
            # `resolved?` / `resolve?` is often a question, not explicit closure.
            resolve_to_me_prefix_punct = [resolve_to_me_prefix_lower[:-1] + p for p in (".", "!", ",")]
            resolved_to_me_prefix_punct = [resolved_to_me_prefix_lower[:-1] + p for p in (".", "!", ",")]
            released_to_me_prefix_punct = [released_to_me_prefix_lower[:-1] + p for p in (".", "!", ",")]
            resolve_to_me_prefix_bare = resolve_to_me_prefix_lower[:-1]
            resolved_to_me_prefix_bare = resolved_to_me_prefix_lower[:-1]
            released_to_me_prefix_bare = released_to_me_prefix_lower[:-1]

            def near_start_direct_mention_line(t: str, pref: str) -> bool:
                # Treat resolve as explicit closure only for a near-start direct mention on this line, not a quote.
                try:
                    t = t or ""
                    i = t.find(pref)
                    if i < 0 or i > 64:
                        return False
                    if i > 0 and t[i - 1] not in (" ", ":", "(", "[", "{"):
                        return False
                    prefix = t[:i]
                    bad = [chr(34), chr(39), chr(96), ">"]
                    if any(q in prefix for q in bad):
                        return False
                    return True
                except Exception:
                    return False

            def near_start_direct_mention_bare_line(t: str, pref: str) -> bool:
                # Like near_start_direct_mention_line, but for bare `@<me>: resolve` / `resolved` (no trailing punctuation).
                # Require a word boundary; specifically reject `resolve?` / `resolved?`.
                try:
                    t = t or ""
                    i = t.find(pref)
                    if i < 0 or i > 64:
                        return False
                    if i > 0 and t[i - 1] not in (" ", ":", "(", "[", "{"):
                        return False
                    prefix = t[:i]
                    bad = [chr(34), chr(39), chr(96), ">"]
                    if any(q in prefix for q in bad):
                        return False
                    j = i + len(pref)
                    if j >= len(t):
                        return True
                    nxt = t[j]
                    if nxt == "?":
                        return False
                    if nxt.isspace() or nxt in (".", "!", ",", ":"):
                        return True
                    return False
                except Exception:
                    return False

            def strip_common_list_prefix(s: str) -> str:
                # Support common "reply checklist" formatting like:
                # - @B: ack: ...
                # - [x] @B: ack: ...
                # 1. @B: ack: ...
                try:
                    s = s or ""
                    if not s:
                        return s
                    if s[0] in ("-", "*", "+"):
                        i = 1
                        while i < len(s) and s[i].isspace():
                            i += 1
                        s2 = s[i:]
                    else:
                        s2 = s
                    i = 0
                    while i < len(s2) and s2[i].isdigit():
                        i += 1
                    if (
                        i > 0
                        and i < len(s2)
                        and s2[i] in (".", ")")
                        # Require whitespace after the marker to avoid stripping e.g. "1.23".
                        and i + 1 < len(s2)
                        and s2[i + 1].isspace()
                    ):
                        i += 1
                        while i < len(s2) and s2[i].isspace():
                            i += 1
                        s2 = s2[i:]

                    # GitHub-style task list marker: "- [x] ..." / "- [ ] ..."
                    if s2.startswith("[") and len(s2) >= 3 and s2[2] == "]" and s2[1] in (" ", "x", "X"):
                        j = 3
                        while j < len(s2) and s2[j].isspace():
                            j += 1
                        return s2[j:]
                    return s2
                except Exception:
                    return s

            def strip_md_emphasis(s: str) -> str:
                # Support common emphasis wrappers at the start of a reply line, e.g.:
                # **@B: ack:** ...
                # *@B: ack:* ...
                #
                # Keep this intentionally narrow: only strip leading * / _ when they are
                # immediately followed by @.
                try:
                    s = s or ""
                    i = 0
                    while i < len(s) and s[i] in ("*", "_"):
                        i += 1
                    if i == 0 or i > 3 or i >= len(s) or s[i] != "@":
                        return s
                    return s[i:]
                except Exception:
                    return s

            def strip_wrappers(s: str) -> str:
                # Support common punctuation wrappers at the start of a directive, e.g.:
                # (@B: resolve: ...) / [@B: ack: ...]
                try:
                    s = s or ""
                    i = 0
                    stripped = 0
                    while i < len(s) and stripped < 3:
                        if s[i] in ("(", "[", "{"):
                            i += 1
                            stripped += 1
                            while i < len(s) and s[i].isspace():
                                i += 1
                            continue
                        if s[i] == "`" and i + 1 < len(s) and s[i + 1] == "@":
                            # Inline-code wrapper: only treat as a wrapper when it directly precedes a mention,
                            # e.g. "`@B: resolve:` ...".
                            i += 1
                            stripped += 1
                            while i < len(s) and s[i].isspace():
                                i += 1
                            continue
                        break
                    return s[i:]
                except Exception:
                    return s

            def is_indented_at_mention(line: str) -> bool:
                # Ignore indented Markdown "code block" style pastes like:
                # "    @B: resolve: ..." which are almost always prior context.
                try:
                    s = line or ""
                    i = 0
                    spaces = 0
                    saw_tab = False
                    while i < len(s) and s[i] in (" ", "\t"):
                        if s[i] == " ":
                            spaces += 1
                        else:
                            saw_tab = True
                        i += 1
                    if i >= len(s) or s[i] != "@":
                        return False
                    return saw_tab or spaces >= 4
                except Exception:
                    return False

            def is_explicit_closure_txt(txt: str) -> bool:
                # Evaluate per-line so quoted snippets on earlier lines do not suppress real closure on later lines.
                # Ignore fenced code blocks (```), since users paste prior context that can include `@<me>: resolve:`.
                in_fenced_code_block = False
                for line in (txt or "").splitlines()[:16]:
                    t_raw = (line or "").lstrip()
                    if t_raw.startswith("```"):
                        in_fenced_code_block = not in_fenced_code_block
                        continue
                    if in_fenced_code_block:
                        continue
                    if is_indented_at_mention(line):
                        continue
                    t = t_raw.lower()
                    if not t:
                        continue
                    # Humans often omit the colon after the @mention, and sometimes use sentence punctuation
                    # instead of the trailing colon.
                    ack_to_me_prefix_space_lower = ack_to_me_prefix_lower.replace(": ack:", " ack:", 1)
                    ack_needles = [
                        ack_to_me_prefix_lower,
                        ack_to_me_prefix_space_lower,
                        ack_to_me_prefix_lower.replace(": ack:", ": acknowledged", 1),
                        ack_to_me_prefix_space_lower.replace(" ack:", " acknowledged", 1),
                    ]
                    ack_bare = []
                    for n in list(ack_needles):
                        if n.endswith(":"):
                            base = n[:-1]
                            ack_bare.append(base)
                            for p in [".", "!", "?", ","]:
                                ack_needles.append(base + p)
                    def is_ack_line(s: str) -> bool:
                        try:
                            s = s or ""
                            if any(s.startswith(n) for n in ack_needles):
                                return True
                            for base in ack_bare:
                                if s.startswith(base):
                                    after = s[len(base):len(base)+1]
                                    if after == "" or after in (" ", "\t", ".", "!", "?", ",", ":"):
                                        return True
                            return False
                        except Exception:
                            return False
                    if (
                        is_ack_line(t)
                        or is_ack_line(strip_md_emphasis(t))
                        or is_ack_line(strip_md_emphasis(strip_common_list_prefix(t)))
                        or is_ack_line(strip_wrappers(t))
                        or is_ack_line(strip_wrappers(strip_md_emphasis(t)))
                        or is_ack_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))))
                    ):
                        return True
                    if (
                        near_start_direct_mention_line(t, resolve_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(t, p) for p in resolve_to_me_prefix_punct)
                        or near_start_direct_mention_line(t, resolved_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(t, p) for p in resolved_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(t, resolve_to_me_prefix_bare)
                        or near_start_direct_mention_bare_line(t, resolved_to_me_prefix_bare)
                        or near_start_direct_mention_line(t, released_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(t, p) for p in released_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(t, released_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_md_emphasis(t), resolve_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_md_emphasis(t), p) for p in resolve_to_me_prefix_punct)
                        or near_start_direct_mention_line(strip_md_emphasis(t), resolved_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_md_emphasis(t), p) for p in resolved_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_md_emphasis(t), resolve_to_me_prefix_bare)
                        or near_start_direct_mention_bare_line(strip_md_emphasis(t), resolved_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_md_emphasis(t), released_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_md_emphasis(t), p) for p in released_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_md_emphasis(t), released_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), resolve_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), p) for p in resolve_to_me_prefix_punct)
                        or near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), resolved_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), p) for p in resolved_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_md_emphasis(strip_common_list_prefix(t)), resolve_to_me_prefix_bare)
                        or near_start_direct_mention_bare_line(strip_md_emphasis(strip_common_list_prefix(t)), resolved_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), released_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), p) for p in released_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_md_emphasis(strip_common_list_prefix(t)), released_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_wrappers(t), resolve_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(t), p) for p in resolve_to_me_prefix_punct)
                        or near_start_direct_mention_line(strip_wrappers(t), resolved_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(t), p) for p in resolved_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_wrappers(t), resolve_to_me_prefix_bare)
                        or near_start_direct_mention_bare_line(strip_wrappers(t), resolved_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_wrappers(t), released_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(t), p) for p in released_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_wrappers(t), released_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), resolve_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), p) for p in resolve_to_me_prefix_punct)
                        or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), resolved_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), p) for p in resolved_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(t)), resolve_to_me_prefix_bare)
                        or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(t)), resolved_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), released_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), p) for p in released_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(t)), released_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolve_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), p) for p in resolve_to_me_prefix_punct)
                        or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolved_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), p) for p in resolved_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolve_to_me_prefix_bare)
                        or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolved_to_me_prefix_bare)
                        or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), released_to_me_prefix_lower)
                        or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), p) for p in released_to_me_prefix_punct)
                        or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), released_to_me_prefix_bare)
                    ):
                        return True
                return False
            for b, (created_ms, txt) in (last_update or {}).items():
                if not isinstance(b, str) or not b:
                    continue
                if isinstance(txt, str) and is_explicit_closure_txt(txt):
                    continue
                since_s = 0
                try:
                    since_s = int(created_ms // 1000)
                except Exception:
                    since_s = 0
                ack_needles = []
                for base in [
                    f"@{b}: ack",
                    f"@{b} ack",
                    f"@{b}: acknowledged",
                    f"@{b} acknowledged",
                    f"@{b}: thanks",
                    f"@{b} thanks",
                    f"@{b}: got it",
                    f"@{b} got it",
                ]:
                    bl = base.lower()
                    ack_needles.append(bl)
                    ack_needles.append(bl + " ")
                    ack_needles.append(bl + "\t")
                    for p in [":", ".", "!", "?", ","]:
                        ack_needles.append(bl + p)
                acked = False
                rows = conn2.execute(
                    "SELECT body_json FROM messages WHERE agent_id = ? AND kind = \"message\" AND created_at_s >= ? ORDER BY id DESC LIMIT 500",
                    (requester, since_s),
                ).fetchall()
                for (body_json,) in rows:
                    try:
                        body = json.loads(body_json)
                    except Exception:
                        body = body_json
                    txt2 = None
                    if isinstance(body, dict):
                        txt2 = body.get("text")
                    elif isinstance(body, str):
                        txt2 = body
                    if not isinstance(txt2, str):
                        continue
                    t2 = txt2.lstrip().lower()
                    def is_ack_sent_line(s: str) -> bool:
                        try:
                            return any((s or "").startswith(n) for n in ack_needles)
                        except Exception:
                            return False
                    if (
                        is_ack_sent_line(t2)
                        or is_ack_sent_line(strip_md_emphasis(t2))
                        or is_ack_sent_line(strip_md_emphasis(strip_common_list_prefix(t2)))
                        or is_ack_sent_line(strip_wrappers(t2))
                        or is_ack_sent_line(strip_wrappers(strip_md_emphasis(t2)))
                        or is_ack_sent_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t2))))
                    ):
                        acked = True
                        break
                if not acked:
                    pending_ack_agents.add(b)
        finally:
            conn2.close()

    blockers_with_unread_updates = {
        u.get("agent_id")
        for u in (unread_updates or [])
        if isinstance(u, dict)
        and isinstance(u.get("agent_id"), str)
        and u.get("agent_id") in set(blocking_agents or [])
    }
    blockers_with_unread_updates = {b for b in blockers_with_unread_updates if isinstance(b, str) and b}
    blockers_with_any_update = {b for b in blockers_with_any_update if isinstance(b, str) and b}

    suppress_pings_for = set(blockers_with_any_update) | set(blockers_with_unread_updates)
    if suppress_pings_for and isinstance(action_plan, list):
        filtered = []
        for cmd in action_plan:
            if not isinstance(cmd, str):
                filtered.append(cmd)
                continue
            should_drop = False
            for b in suppress_pings_for:
                im = "I" + chr(39) + "m"
                if f"@{b}: {im} about to edit {target_path}. Are you working on it?" in cmd:
                    should_drop = True
                    break
            if not should_drop:
                filtered.append(cmd)
        action_plan = filtered
        # Keep parity between `action_plan` and `action_plan_by_agent[requester]` even when no acks are inserted.
        if isinstance(action_plan_by_agent, dict):
            action_plan_by_agent[requester] = action_plan

    # Closure semantics: suggest a deduped ack per unread update author, and keep suggesting an ack for
    # blockers with a relevant note until the requester actually acks.
    if (isinstance(unread_updates, list) and unread_updates) or pending_ack_agents:
        pinged_blockers = set()
        try:
            if isinstance(action_plan, list):
                im = "I" + chr(39) + "m"
                for b in (blocking_agents or []):
                    if not isinstance(b, str) or not b:
                        continue
                    ping_frag = f"@{b}: {im} about to edit {target_path}. Are you working on it?"
                    if any(isinstance(cmd, str) and ping_frag in cmd for cmd in action_plan):
                        pinged_blockers.add(b)
        except Exception:
            pinged_blockers = set()

        ack_to_me_prefix = f"@{requester}: ack:"
        ack_to_me_prefix_lower = ack_to_me_prefix.lower()
        resolve_to_me_prefix_lower = f"@{requester}: resolve:".lower()
        resolved_to_me_prefix_lower = f"@{requester}: resolved:".lower()
        released_to_me_prefix_lower = f"@{requester}: released:".lower()
        # `resolved?` / `resolve?` is often a question, not explicit closure.
        resolve_to_me_prefix_punct = [resolve_to_me_prefix_lower[:-1] + p for p in (".", "!", ",")]
        resolved_to_me_prefix_punct = [resolved_to_me_prefix_lower[:-1] + p for p in (".", "!", ",")]
        released_to_me_prefix_punct = [released_to_me_prefix_lower[:-1] + p for p in (".", "!", ",")]
        resolve_to_me_prefix_bare = resolve_to_me_prefix_lower[:-1]
        resolved_to_me_prefix_bare = resolved_to_me_prefix_lower[:-1]
        released_to_me_prefix_bare = released_to_me_prefix_lower[:-1]

        def near_start_direct_mention_line(t: str, pref: str) -> bool:
            # Treat resolve as explicit closure only for a near-start direct mention on this line, not a quote.
            try:
                t = t or ""
                i = t.find(pref)
                if i < 0 or i > 64:
                    return False
                if i > 0 and t[i - 1] not in (" ", ":", "(", "[", "{"):
                    return False
                prefix = t[:i]
                bad = [chr(34), chr(39), chr(96), ">"]
                if any(q in prefix for q in bad):
                    return False
                return True
            except Exception:
                return False

        def near_start_direct_mention_bare_line(t: str, pref: str) -> bool:
            # Like near_start_direct_mention_line, but for bare `@<me>: resolve` / `resolved` (no trailing punctuation).
            # Require a word boundary; specifically reject `resolve?` / `resolved?`.
            try:
                t = t or ""
                i = t.find(pref)
                if i < 0 or i > 64:
                    return False
                if i > 0 and t[i - 1] not in (" ", ":", "(", "[", "{"):
                    return False
                prefix = t[:i]
                bad = [chr(34), chr(39), chr(96), ">"]
                if any(q in prefix for q in bad):
                    return False
                j = i + len(pref)
                if j >= len(t):
                    return True
                nxt = t[j]
                if nxt == "?":
                    return False
                if nxt.isspace() or nxt in (".", "!", ",", ":"):
                    return True
                return False
            except Exception:
                return False

        def strip_common_list_prefix(s: str) -> str:
            # Support common "reply checklist" formatting like:
            # - @B: ack: ...
            # - [x] @B: ack: ...
            # 1. @B: ack: ...
            try:
                s = s or ""
                if not s:
                    return s
                if s[0] in ("-", "*", "+"):
                    i = 1
                    while i < len(s) and s[i].isspace():
                        i += 1
                    s2 = s[i:]
                else:
                    s2 = s
                i = 0
                while i < len(s2) and s2[i].isdigit():
                    i += 1
                if (
                    i > 0
                    and i < len(s2)
                    and s2[i] in (".", ")")
                    # Require whitespace after the marker to avoid stripping e.g. "1.23".
                    and i + 1 < len(s2)
                    and s2[i + 1].isspace()
                ):
                    i += 1
                    while i < len(s2) and s2[i].isspace():
                        i += 1
                    s2 = s2[i:]

                # GitHub-style task list marker: "- [x] ..." / "- [ ] ..."
                if s2.startswith("[") and len(s2) >= 3 and s2[2] == "]" and s2[1] in (" ", "x", "X"):
                    j = 3
                    while j < len(s2) and s2[j].isspace():
                        j += 1
                    return s2[j:]
                return s2
            except Exception:
                return s

        def strip_md_emphasis(s: str) -> str:
            # Support common emphasis wrappers at the start of a reply line, e.g.:
            # **@B: ack:** ...
            # *@B: ack:* ...
            #
            # Keep this intentionally narrow: only strip leading * / _ when they are
            # immediately followed by @.
            try:
                s = s or ""
                i = 0
                while i < len(s) and s[i] in ("*", "_"):
                    i += 1
                if i == 0 or i > 3 or i >= len(s) or s[i] != "@":
                    return s
                return s[i:]
            except Exception:
                return s

        def strip_wrappers(s: str) -> str:
            # Support common punctuation wrappers at the start of a directive, e.g.:
            # (@B: resolve: ...) / [@B: ack: ...]
            try:
                s = s or ""
                i = 0
                stripped = 0
                while i < len(s) and stripped < 3:
                    if s[i] in ("(", "[", "{"):
                        i += 1
                        stripped += 1
                        while i < len(s) and s[i].isspace():
                            i += 1
                        continue
                    if s[i] == "`" and i + 1 < len(s) and s[i + 1] == "@":
                        i += 1
                        stripped += 1
                        while i < len(s) and s[i].isspace():
                            i += 1
                        continue
                    break
                return s[i:]
            except Exception:
                return s

        def is_indented_at_mention(line: str) -> bool:
            # Ignore indented Markdown "code block" style pastes like:
            # "    @B: resolve: ..." which are almost always prior context.
            try:
                s = line or ""
                i = 0
                spaces = 0
                saw_tab = False
                while i < len(s) and s[i] in (" ", "\t"):
                    if s[i] == " ":
                        spaces += 1
                    else:
                        saw_tab = True
                    i += 1
                if i >= len(s) or s[i] != "@":
                    return False
                return saw_tab or spaces >= 4
            except Exception:
                return False

        def is_closure_to_me(u):
            if not isinstance(u, dict):
                return False
            body = u.get("body")
            txt = None
            if isinstance(body, dict):
                txt = body.get("text")
            elif isinstance(body, str):
                txt = body
            if not isinstance(txt, str):
                return False
            # Evaluate per-line so a quoted resolve on one line does not suppress a real resolve on another.
            # Ignore fenced code blocks (```), since users paste prior context that can include `@<me>: resolve:`.
            in_fenced_code_block = False
            for line in (txt or "").splitlines()[:16]:
                t_raw = (line or "").lstrip()
                if t_raw.startswith("```"):
                    in_fenced_code_block = not in_fenced_code_block
                    continue
                if in_fenced_code_block:
                    continue
                if is_indented_at_mention(line):
                    continue
                t = t_raw.lower()
                if not t:
                    continue
                # Humans often omit the colon after the @mention, and sometimes use sentence punctuation
                # (or a comma) instead of the trailing colon after `ack`.
                ack_to_me_prefix_space_lower = ack_to_me_prefix_lower.replace(": ack:", " ack:", 1)
                ack_needles = [
                    ack_to_me_prefix_lower,
                    ack_to_me_prefix_space_lower,
                    ack_to_me_prefix_lower.replace(": ack:", ": acknowledged", 1),
                    ack_to_me_prefix_space_lower.replace(" ack:", " acknowledged", 1),
                    # Common "ack" synonyms used as a directed reply to an agent.
                    ack_to_me_prefix_lower.replace(": ack:", ": thanks", 1),
                    ack_to_me_prefix_space_lower.replace(" ack:", " thanks", 1),
                    ack_to_me_prefix_lower.replace(": ack:", ": got it", 1),
                    ack_to_me_prefix_space_lower.replace(" ack:", " got it", 1),
                ]
                ack_bare = []
                for n in list(ack_needles):
                    if n.endswith(":"):
                        base = n[:-1]
                        ack_bare.append(base)
                        for p in [".", "!", "?", ","]:
                            ack_needles.append(base + p)
                def is_ack_line(s: str) -> bool:
                    try:
                        s = s or ""
                        if any(s.startswith(n) for n in ack_needles):
                            return True
                        for base in ack_bare:
                            if s.startswith(base):
                                after = s[len(base):len(base)+1]
                                if after == "" or after in (" ", "\t", ".", "!", "?", ",", ":"):
                                    return True
                        return False
                    except Exception:
                        return False
                if (
                    is_ack_line(t)
                    or is_ack_line(strip_md_emphasis(t))
                    or is_ack_line(strip_md_emphasis(strip_common_list_prefix(t)))
                    or is_ack_line(strip_wrappers(t))
                    or is_ack_line(strip_wrappers(strip_md_emphasis(t)))
                    or is_ack_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))))
                ):
                    return True
                if (
                    near_start_direct_mention_line(t, resolve_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(t, p) for p in resolve_to_me_prefix_punct)
                    or near_start_direct_mention_line(t, resolved_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(t, p) for p in resolved_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(t, resolve_to_me_prefix_bare)
                    or near_start_direct_mention_bare_line(t, resolved_to_me_prefix_bare)
                    or near_start_direct_mention_line(t, released_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(t, p) for p in released_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(t, released_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_md_emphasis(t), resolve_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_md_emphasis(t), p) for p in resolve_to_me_prefix_punct)
                    or near_start_direct_mention_line(strip_md_emphasis(t), resolved_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_md_emphasis(t), p) for p in resolved_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_md_emphasis(t), resolve_to_me_prefix_bare)
                    or near_start_direct_mention_bare_line(strip_md_emphasis(t), resolved_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_md_emphasis(t), released_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_md_emphasis(t), p) for p in released_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_md_emphasis(t), released_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), resolve_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), p) for p in resolve_to_me_prefix_punct)
                    or near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), resolved_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), p) for p in resolved_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_md_emphasis(strip_common_list_prefix(t)), resolve_to_me_prefix_bare)
                    or near_start_direct_mention_bare_line(strip_md_emphasis(strip_common_list_prefix(t)), resolved_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), released_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_md_emphasis(strip_common_list_prefix(t)), p) for p in released_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_md_emphasis(strip_common_list_prefix(t)), released_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_wrappers(t), resolve_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(t), p) for p in resolve_to_me_prefix_punct)
                    or near_start_direct_mention_line(strip_wrappers(t), resolved_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(t), p) for p in resolved_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_wrappers(t), resolve_to_me_prefix_bare)
                    or near_start_direct_mention_bare_line(strip_wrappers(t), resolved_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_wrappers(t), released_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(t), p) for p in released_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_wrappers(t), released_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), resolve_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), p) for p in resolve_to_me_prefix_punct)
                    or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), resolved_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), p) for p in resolved_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(t)), resolve_to_me_prefix_bare)
                    or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(t)), resolved_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), released_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(t)), p) for p in released_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(t)), released_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolve_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), p) for p in resolve_to_me_prefix_punct)
                    or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolved_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), p) for p in resolved_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolve_to_me_prefix_bare)
                    or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), resolved_to_me_prefix_bare)
                    or near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), released_to_me_prefix_lower)
                    or any(near_start_direct_mention_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), p) for p in released_to_me_prefix_punct)
                    or near_start_direct_mention_bare_line(strip_wrappers(strip_md_emphasis(strip_common_list_prefix(t))), released_to_me_prefix_bare)
                ):
                    return True
            return False

        ack_set = set()
        if isinstance(unread_updates, list):
            for u in unread_updates:
                if not isinstance(u, dict):
                    continue
                a = u.get("agent_id")
                if not isinstance(a, str) or not a or a == requester:
                    continue
                if a in pinged_blockers:
                    continue
                if is_closure_to_me(u):
                    continue
                ack_set.add(a)
        for a in pending_ack_agents:
            if not isinstance(a, str) or not a or a == requester:
                continue
            if a in pinged_blockers:
                continue
            ack_set.add(a)

        for a in sorted(ack_set):
            cmd = f"but-engineering-rewrite --agent-id {requester} post \"@{a}: ack: saw your update re {target_path}.\""
            if action_plan and isinstance(action_plan[-1], str) and " check --path " in action_plan[-1]:
                action_plan.insert(max(0, len(action_plan) - 1), cmd)
            else:
                action_plan.append(cmd)
        if isinstance(action_plan_by_agent, dict):
            action_plan_by_agent[requester] = action_plan
except Exception:
    # Keep stub behavior resilient; never fail the harness due to "nice to have" plan enrichment.
    pass

out = {
    "decision": os.environ.get("OUT_DECISION", ""),
    "reason_code": os.environ.get("OUT_REASON", ""),
